# Copy to .env and fill in (.env is gitignored).
#
# Local development (compose.yaml): only POSTGRES_PORT is read; the database passwords there are
# fixed development values. The server (./gradlew :server:bootRun) reads environment variables,
# not this file: export what you need, e.g. LOGOS_API_KEY.
#
# Deployment (compose.prod.yaml): every value below. In CI they come from the GitHub environment's
# secrets and variables; the deploy workflow writes them into .env on the VM next to IMAGE_TAG.
# This file is for a manual deploy. Values marked "required" have no default.

# Port of the development Postgres on the host (compose.yaml).
POSTGRES_PORT=5432

# Image tag to run (CI injects this; defaults to latest for a manual deploy).
IMAGE_TAG=latest
# Public host name (must match the TLS certificate). The three clients are served under
# /learninggoalhub, /workshopper and /examlense on it.
APP_HOST=your-vm.example.tum.de
# Spring profile; empty = the deploy target, which application.yml maps to `local` on Staging
# (development login) and `prod` on Production.
# SPRING_PROFILES_ACTIVE=
JAVA_OPTS=-XX:MaxRAMPercentage=70

# Database (required). The superuser password, and the passwords of the two roles that
# infra/postgres/init creates on the first start: hestia_owner (Flyway) and hestia_app (server).
HESTIA_POSTGRES_PASSWORD=
HESTIA_OWNER_PASSWORD=
HESTIA_APP_PASSWORD=
# Daily database dumps: host directory and how many days to keep.
BACKUP_DIR=/opt/hestia/backups/hestia
BACKUP_KEEP_DAYS=14

# TUM AET Logos gateway (required), used by the materials and teaching modules.
HESTIA_LOGOS_API_KEY=

# assessment (ExamLense): AI providers; each key is optional, without it its strategies are off.
EXAMLENSE_OPENAI_API_KEY=
EXAMLENSE_ANTHROPIC_API_KEY=
EXAMLENSE_GEMINI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Interim token login: shared bootstrap token baked into the ExamLense client build (empty = off),
# and a separate token that grants ADMIN (no default).
EXAMLENSE_API_AUTH_TOKEN=
EXAMLENSE_ADMIN_BOOTSTRAP_TOKEN=
# HMAC key for signed file URLs (required).
EXAMLENSE_FILES_SIGNING_SECRET=
# Registration and daily quotas.
# EXAMLENSE_OPEN_REGISTRATION=true
# EXAMLENSE_REGISTRATIONS_PER_IP_PER_DAY=5
# EXAMLENSE_QUOTA_PARSE_PER_DAY=20
# EXAMLENSE_QUOTA_SOLVE_PER_DAY=20
# EXAMLENSE_QUOTA_GLOBAL_PARSE_PER_DAY=200
# EXAMLENSE_QUOTA_GLOBAL_SOLVE_PER_DAY=200
# Behind Traefik and nginx: trust X-Forwarded-For over two hops for the per-IP limits.
# API_RATELIMIT_BEHIND_PROXY=true
# API_RATELIMIT_TRUSTED_PROXY_HOPS=2
