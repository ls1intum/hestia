# LLM Configuration (TUM AET Logos gateway, the shared-llm default)
WORKSHOPPER_LOGOS_API_KEY=your_api_key_here
# Optional secondary model (used for slide generation); must be a Logos model id
# (openai/gpt-oss-120b or Qwen/Qwen3.8-27B)
# LLM_SECONDARY_MODEL=

# Spring profile: "local" signs every request in as one dev user (local development and the
# VPN-only hestia-test VM; never production); compose.prod.yaml defaults to "prod"
# SPRING_PROFILES_ACTIVE=local

# Database (optional for local dev; the defaults match compose.yaml)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# POSTGRES_DB=workshopper
# POSTGRES_USER=workshopper
# POSTGRES_PASSWORD=workshopper
# POSTGRES_URL=  (overrides host/port/db)

# ── Deployment (compose.prod.yaml) ──────────────────────────────────────────
# WORKSHOPPER_POSTGRES_PASSWORD=   required
# APP_HOST=                        host name for the Traefik route
# IMAGE_TAG=latest
# JAVA_OPTS=-XX:MaxRAMPercentage=70
# SAML_PRIVATE_KEY_LOCATION=file:/app/certs/private-key.pem
# SAML_CERTIFICATE_LOCATION=file:/app/certs/certificate.crt

# ── Client dev server (apps/workshopper/client, read by vite.config.ts) ────────
# VITE_API_TARGET=http://localhost:8081   Workshopper server
# VITE_LGH_TARGET=http://localhost:8080   Learning Goal Hub server (goal import)
# VITE_API_URL=                           API base URL override (defaults to <base>/api)
