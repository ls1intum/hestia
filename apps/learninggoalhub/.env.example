# Copy to .env and adjust as needed. .env is gitignored.

# Postgres (POSTGRES_DB/USER are used by compose.yaml and compose.prod.yaml; the password and
# port only by local dev with compose.yaml + bootRun)
POSTGRES_DB=learninggoalhub
POSTGRES_USER=learninggoalhub
POSTGRES_PASSWORD=learninggoalhub
POSTGRES_PORT=5432

# TUM AET Logos (consumed by a locally run server; the default provider for chat and vision)
LOGOS_API_KEY=

# Deployment only (compose.prod.yaml). In CI these come from GitHub environment
# secrets/variables; this file is for manual deploys on the VM. The shared Traefik proxy
# (infra/traefik) owns host ports 80/443 and terminates TLS, so this app publishes no host
# port — it is routed by host + path prefix instead.
# Image tag to run (CI injects this; defaults to latest for a manual deploy).
IMAGE_TAG=latest
# Database password and Logos key of the deployed stack (app-prefixed, like the repo secrets).
LEARNINGGOALHUB_POSTGRES_PASSWORD=
LEARNINGGOALHUB_LOGOS_API_KEY=
# Keys the ExamLens and Workshopper servers send in X-Api-Key (e.g. `openssl rand -hex 32`), and
# whether the service-only endpoints require them (leave false until both consumers send them).
LEARNINGGOALHUB_API_KEY_EXAMLENSE=
LEARNINGGOALHUB_API_KEY_WORKSHOPPER=
LEARNINGGOALHUB_ENFORCE_SERVICE_KEYS=false
# Public hostname this app answers on (must match the TLS cert SAN). e.g. your VM's FQDN.
# The app is served under the fixed path prefix /learninggoalhub (Traefik labels, Vite base).
APP_HOST=your-vm.example.tum.de
# Host directory for the daily database dumps and how many days of them to keep.
BACKUP_DIR=/opt/hestia/backups/learninggoalhub
BACKUP_KEEP_DAYS=14
# JVM options for the server container; heap is sized from the container mem_limit.
JAVA_OPTS=-XX:MaxRAMPercentage=70
