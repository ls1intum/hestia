# Copy to .env and adjust for a manual/fallback deploy on the VM (.env is gitignored).
# In CI these values come from the GitHub environment secrets/variables; the reusable
# deploy workflow writes them into .env next to the injected IMAGE_TAG. Any name that
# compose.prod.yaml references must exist here (or as a GitHub secret/variable).

# Image tag to run (CI injects this; defaults to latest for a manual deploy).
IMAGE_TAG=latest

# Public host (must match the TLS cert SAN). This is a shared variable in the deploy
# environment (the VM FQDN, same for every app on the VM). The URL path prefix (/examlense)
# is NOT here — it is hardcoded in compose.prod.yaml so it can't collide with another app's
# shared APP_PATH_PREFIX.
APP_HOST=hestia-test.aet.cit.tum.de

# Postgres (private to this app).
POSTGRES_DB=examlense
POSTGRES_USER=examlense
POSTGRES_PASSWORD=change-me

# OpenAI native API — enables gpt-* parser/solver strategies.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic native API — enables claude-* parser/solver strategies.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini API key (Google AI Studio) — enables the gemini-* PDF parser strategies.
# Optional: leave blank to disable them. NOTE: the free tier may use submitted content for
# training — do not use it for confidential exams.
GEMINI_API_KEY=

# LearningGoalHub base URL — derives learning goals per exam task at section confirm.
# Defaults to the deployed instance in compose.prod.yaml; only set here to override
# (e.g. http://localhost:8080 for a local LGH).
LGH_BASE_URL=https://hestia-test.aet.cit.tum.de/learninggoalhub

# Static bearer token. Baked into the client bundle too, so it is NOT secret — it only
# needs to match client/.env.production's VITE_API_AUTH_TOKEN.
API_AUTH_TOKEN=dev-local-token

# Separate secret that grants ADMIN. Deliberately NOT the token above: that value is
# committed here, so admin behind it would be admin for anyone reading the repo. Leave
# empty unless you are bootstrapping the first admin, and use a long random value
# (`openssl rand -base64 32`) when you do.
# Open registration: a first visit creates an account with nothing asked of the user.
# Set false to freeze the instance to existing token holders.
OPEN_REGISTRATION=true
# New accounts per IP per day. Without a cap, clearing browser storage mints a fresh
# account with a fresh LLM quota, so per-user metering would bound nothing.
REGISTRATIONS_PER_IP_PER_DAY=5

# Instance-wide LLM ceilings, across every account. The per-user quotas are a
# fairness control; these are the real cap on spend, since open registration means
# a used-up account can be traded for a fresh allowance.
QUOTA_GLOBAL_PARSE_PER_DAY=200
QUOTA_GLOBAL_SOLVE_PER_DAY=200

ADMIN_BOOTSTRAP_TOKEN=

# HMAC key for signed file URLs. REQUIRED — compose.prod.yaml refuses to start without it.
# Use a fresh random value (e.g. `openssl rand -hex 32`), unrelated to API_AUTH_TOKEN: when
# unset the server signs with the auth token, which ships in the client bundle, making file
# URLs forgeable. See DEPLOY.md "Security model".
EXAMLENSE_FILES_SIGNING_SECRET=

# JVM options for the server container; heap is sized from the container mem_limit.
JAVA_OPTS=-XX:MaxRAMPercentage=70
