# Copy to .env and fill in. Load with: set -a; source .env; set +a
# (Spring Boot does not auto-read .env files.)

# --- Auth ---
# Single-user server: a static bearer token gates the API (no real user auth yet).
# Must match the client's VITE_API_AUTH_TOKEN (also "dev-local-token" by default).
API_AUTH_TOKEN=dev-local-token

# Separate secret that grants ADMIN. Deliberately NOT the token above: that value is
# committed here, so admin behind it would be admin for anyone reading the repo. Leave
# empty unless you are bootstrapping the first admin, and use a long random value
# (`openssl rand -base64 32`) when you do.
# Open registration: a first visit creates an account with nothing asked of the user.
# Set false to freeze the instance to existing token holders.
OPEN_REGISTRATION=true
# New accounts per IP per day. Without a cap, clearing browser storage mints a fresh
# account with a fresh LLM quota, so per-user metering would bound nothing.
REGISTRATIONS_PER_IP_PER_DAY=5

# Instance-wide LLM ceilings, across every account. The per-user quotas are a
# fairness control; these are the real cap on spend, since open registration means
# a used-up account can be traded for a fresh allowance.
QUOTA_GLOBAL_PARSE_PER_DAY=200
QUOTA_GLOBAL_SOLVE_PER_DAY=200

ADMIN_BOOTSTRAP_TOKEN=

# Dedicated HMAC key for signed file URLs (/api/files/**). Recommended in
# deployments: keeps the URL-signing key separate from the bearer token, so
# rotating the token doesn't invalidate outstanding URLs. When unset, the
# server falls back to API_AUTH_TOKEN and logs a warning at startup.
FILES_SIGNING_SECRET=

# Trust X-Forwarded-For for the per-IP rate limiter. Enable ONLY when the
# server sits behind a reverse proxy; otherwise clients could spoof their IP.
API_RATELIMIT_BEHIND_PROXY=false

# --- AI providers ---
# GWDG (OpenAI-compatible) — the primary provider.
AI_API_KEY=
AI_BASE_URL=https://chat-ai.academiccloud.de/v1

# OpenAI (native Responses API) — optional; enables gpt-* parser/solver strategies.
# OPENAI_BASE_URL has a working default, so it's rarely needed.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (native Messages API) — optional; enables claude-* parser/solver strategies.
# ANTHROPIC_BASE_URL has a working default, so it's rarely needed.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini (native API) — optional; enables the gemini-* PDF parser strategies.
# Leave blank to disable them. GEMINI_BASE_URL has a working default, so it's rarely needed.
GEMINI_API_KEY=

# --- API docs ---
# Expose the OpenAPI spec (/v3/api-docs) and Swagger UI (/swagger-ui.html).
# The `local` profile enables these already; set this only to browse the docs on
# a deployed instance. They are unauthenticated when enabled, so leave it false
# anywhere the spec shouldn't be public.
API_DOCS_ENABLED=false

# --- HTTP server ---
PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
