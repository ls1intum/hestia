# Baked into the client bundle by `npm run build` (Vite auto-loads .env.production).
#
# Same-origin API: requests go to /examlense/api/... which Traefik strips to /api/... and
# the web (nginx) container proxies to the server. Keep this in sync with vite.config `base`.
VITE_API_BASE_URL=/examlense

# The SHARED bootstrap token. COMPILED INTO THE BROWSER BUNDLE, so it is not secret.
# Production builds IGNORE it (see src/lib/api/token-store.ts — the fallback is gated on
# import.meta.env.DEV), so real users always go through enrolment. It is kept only so a
# production bundle can still be pointed at a bootstrap server during setup, and it must
# match the server's API_AUTH_TOKEN if you do that (see compose.prod.yaml).
VITE_API_AUTH_TOKEN=dev-local-token
