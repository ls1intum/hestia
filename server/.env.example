# Copy to .env and fill in. Load with: set -a; source .env; set +a
# (Spring Boot does not auto-read .env files.)

# --- Auth ---
# Login is the session login of the hestia server (TUM SAML; the `local` profile signs in a dev user).
# Platform admins (parse-metrics dashboard): comma-separated external ids, see application.yml.
# HESTIA_PLATFORM_ADMINS=

# Daily ExamLense jobs per user (reading in an exam / letting a model solve it), rolling 24 h.
# 0 turns a limit off. There is no organisation-wide ceiling.
HESTIA_AI_LIMIT_EXAM_PARSE=10
HESTIA_AI_LIMIT_EXAM_SOLVE=30

# HMAC key for signed file URLs (/api/files/**). When unset a random key is used per start,
# so file URLs stop working after a restart.
FILES_SIGNING_SECRET=

# Trust X-Forwarded-For for the per-IP rate limiter. Enable ONLY when the
# server sits behind a reverse proxy; otherwise clients could spoof their IP.
API_RATELIMIT_BEHIND_PROXY=false

# --- AI providers ---
# TUM AET Logos gateway — every model except the external benchmark models below.
LOGOS_API_KEY=

# OpenAI (native Responses API) — optional; enables gpt-* parser/solver strategies.
# The base URL defaults are in server/src/main/resources/modules/ai.yml.
OPENAI_API_KEY=

# Anthropic (native Messages API) — optional; enables claude-* parser/solver strategies.
# The base URL defaults are in server/src/main/resources/modules/ai.yml.
ANTHROPIC_API_KEY=

# Google Gemini (native API) — optional; enables the gemini-* PDF parser strategies.
# Leave blank to disable them. GEMINI_BASE_URL defaults as in ai.yml.
GEMINI_API_KEY=

# --- API docs ---
# Expose the assessment OpenAPI spec (/v3/api-docs/assessment) and Swagger UI (/swagger-ui.html).
# The `local` profile enables these already; set this only to browse the docs on
# a deployed instance. They are unauthenticated when enabled, so leave it false
# anywhere the spec shouldn't be public.
API_DOCS_ENABLED=false

# --- HTTP server ---
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
